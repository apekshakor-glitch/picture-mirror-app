# ==============================================================================
# DaRI AI Picture Mirror - Environment Configuration Example
# Copy this file to '.env' for local development.
# DO NOT commit real secrets or passwords to source control.
# In AWS ECS Fargate, secrets are injected via AWS Secrets Manager or Systems Manager.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL on AWS RDS)
# If DATABASE_URL is provided, it takes precedence. Otherwise DB_* variables are used.
DATABASE_URL=
DB_HOST=dariai-picture-mirror-dev.c7em0as8esn6.ap-south-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# Supply the RDS database password in your local untracked .env file
DB_PASSWORD=

# Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# AWS S3 Configuration
AWS_REGION=ap-south-2
S3_BUCKET_NAME=dari-ai-picture-mirror-dev

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
